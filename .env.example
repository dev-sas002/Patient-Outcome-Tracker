# Copy to .env for docker compose. Every value here has a working default in
# docker-compose.yml, so `docker compose up --build` works with no .env at all.

# Signs and verifies JWTs. Shared by auth-service and outcome-service.
# Generate a real one for anything but a local demo: openssl rand -hex 32
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRES_IN=24h

# Per-clinic connection cache ceiling. See "Design notes" in the README.
TENANT_MAX_CONNECTIONS=50

# Smallest diagnosis cohort that may be reported on its own. Anything smaller
# is folded into "Other (grouped)".
INSIGHT_MIN_GROUP_SIZE=5

# Optional. Unset, the outcome summary is computed locally and no request
# leaves the host. Set it to have Claude write the summary instead.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
